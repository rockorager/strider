#!/usr/bin/env bash
# Prepares a fresh Amp orb (Debian) to build, test, and lint Strider: siv's
# system libraries and what the program and tests call from apt, the
# toolchain in mise.toml from mise, and bs and baskingspot-lint from
# `just setup`, as on any other machine.
# Idempotent: a warm orb skips downloads and package installs.
set -euo pipefail

MISE_VERSION=2026.11.6

step() { printf '==> %s\n' "$*"; }

# What siv links (libwayland-client, xkbcommon, Fontconfig, the Vulkan
# headers), the keymaps its keyboard handling compiles, shared-mime-info
# and desktop-file-utils for running the program, dbus (with dbus-daemon)
# for its single-instance and FileManager1 services and the D-Bus tests,
# and what previews call: poppler's pdftoppm and libarchive's bsdtar.
packages=(
	ca-certificates curl xz-utils pkg-config git
	libwayland-dev libxkbcommon-dev libfontconfig-dev xkb-data
	libvulkan-dev mesa-vulkan-drivers
	shared-mime-info desktop-file-utils dbus
	poppler-utils libarchive-tools
)

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bin="$HOME/.local/bin"

install_packages() {
	local missing=()
	for p in "${packages[@]}"; do
		dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'install ok installed' || missing+=("$p")
	done
	if ((${#missing[@]})); then
		step "apt-get install ${missing[*]}"
		sudo apt-get update -qq
		sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "${missing[@]}"
	else
		step "system packages already installed"
	fi
}

install_mise() {
	if [[ $(mise --version 2>/dev/null) != "$MISE_VERSION "* ]]; then
		step "install mise $MISE_VERSION"
		curl -fsSL https://mise.run | MISE_VERSION="v$MISE_VERSION" MISE_INSTALL_PATH="$bin/mise" sh
	fi
	mise trust -q mise.toml
	mise install
	# The agent's shells do not activate mise, so its shims go on PATH,
	# where they run the versions mise.toml names.
	local shims="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims" shim
	for shim in "$shims"/*; do
		ln -sfn "$shim" "$bin/$(basename "$shim")"
	done
}

# Fetch siv and its pinned packages and warm the caches with the tests,
# built by bs as development builds are, so the first build in a thread
# is incremental.
build_once() {
	step "just test"
	just test
}

cd "$repo_root"
mkdir -p "$bin"
export PATH="$bin:$PATH"
.agents/resume
install_packages
install_mise
just setup
build_once
zig version
