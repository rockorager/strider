#!/usr/bin/env bash
# Prepares a fresh Amp orb (Debian, x86_64) to build, test, and lint
# Strider: what the program and its tests load and call from apt, the tools
# in mise.toml from mise, and Rust from rustup, as on any other machine.
# Idempotent: a warm orb skips downloads and installs.
set -euo pipefail

MISE_VERSION=2026.11.6

# The build links nothing but libc. Keywork loads libfontconfig and
# libvulkan (Mesa's drivers, lavapipe among them) at run time, and the
# text is in monospace; DejaVu is a monospace font for the renders. shared-mime-info and desktop-file-utils for types and
# applications; dbus (with dbus-daemon) for the single instance, the
# FileManager1 and portal services, and their tests on a private bus; and
# what previews call: poppler's pdftoppm, libarchive's bsdtar, and ffmpeg.
packages=(
	ca-certificates curl git xz-utils
	fontconfig libfontconfig1 fonts-dejavu-core
	libvulkan1 mesa-vulkan-drivers
	shared-mime-info desktop-file-utils dbus
	poppler-utils libarchive-tools ffmpeg
)

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bin="$HOME/.local/bin"

# Each step says how long setup has run, so its log shows the slow one.
step() { printf '==> %3ds %s\n' "$SECONDS" "$*"; }

install_packages() {
	local missing=()
	for p in "${packages[@]}"; do
		dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'install ok installed' || missing+=("$p")
	done
	if ((${#missing[@]})); then
		step "apt-get install ${missing[*]}"
		sudo apt-get update -qq
		sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "${missing[@]}"
	else
		step "system packages already installed"
	fi
}

install_mise() {
	if [[ $(mise --version 2>/dev/null) != "$MISE_VERSION "* ]]; then
		step "install mise $MISE_VERSION"
		curl -fsSL https://mise.run | MISE_VERSION="v$MISE_VERSION" MISE_INSTALL_PATH="$bin/mise" sh
	fi
	mise trust -q mise.toml
	step "mise install"
	mise install
	# The agent's shells do not activate mise, so its shims go on PATH,
	# where they run the versions mise.toml names.
	local shims="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims" shim
	for shim in "$shims"/*; do
		ln -sfn "$shim" "$bin/$(basename "$shim")"
	done
}

# Rust from rustup, which reads rust-toolchain.toml for the version and
# its components.
install_rust() {
	if ! command -v rustup >/dev/null && [[ ! -x $HOME/.cargo/bin/rustup ]]; then
		step "install rustup"
		curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none
	fi
	local tool
	for tool in rustup cargo rustc; do
		ln -sfn "$HOME/.cargo/bin/$tool" "$bin/$tool"
	done
	step "rustup toolchain install"
	"$HOME/.cargo/bin/rustup" toolchain install --no-self-update
}

cd "$repo_root"
mkdir -p "$bin"
export PATH="$bin:$HOME/.cargo/bin:$PATH"
install_packages
install_mise
install_rust
# Fetch the crates and warm the build with the tests, so the first build
# in a thread is incremental.
step "just test"
just test
step "done"
